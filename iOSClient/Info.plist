<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.hammant.porthole.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>porthole</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_porthole._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Porthole scans the code on your Mac to pair with it.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Finds your Mac on the local network.</string>
	<key>UIAppFonts</key>
	<array>
		<string>HackNerdFontMono-Regular.ttf</string>
		<string>HackNerdFontMono-Bold.ttf</string>
	</array>
