<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Porthole for Mac as released (Scripts/porthole-release-mac.sh): Apple Events for iTerm2 and Chrome,
	     and nothing a debugger needs (the notary refuses get-task-allow). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
